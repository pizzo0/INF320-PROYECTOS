<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="GP.Views.CreateTransactionPage"
    BackgroundColor="#F8FAFC">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- Encabezado morado -->
            <Border StrokeThickness="0"
                    Padding="24,32,24,64">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3B0764" Offset="0.0" />
                        <GradientStop Color="#7E22CE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Nueva transacción"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <Label
                        Text="Controla tus finanzas fácilmente"
                        FontSize="14"
                        TextColor="#C4B5FD"/>
                </VerticalStackLayout>
            </Border>

            <!-- Contenido que se superpone al encabezado -->
            <VerticalStackLayout
                Padding="24,0,24,24"
                Spacing="22"
                Margin="0,-46,0,0">

                <!-- Card -->

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="22">

                    <Border.Shadow>
                        <Shadow Brush="#7E22CE" Opacity="0.18" Radius="22" Offset="0,8" />
                    </Border.Shadow>

                    <VerticalStackLayout
                        Spacing="20">

                        <!-- Descripción -->

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="DESCRIPCIÓN"
                                FontSize="12"
                                FontAttributes="Bold"
                                CharacterSpacing="0.6"
                                TextColor="#94A3B8"/>

                            <Border
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,2">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label
                                        Grid.Column="0"
                                        Text="edit_note"
                                        FontFamily="MaterialSymbols"
                                        FontSize="20"
                                        TextColor="#94A3B8"
                                        VerticalOptions="Center"/>

                                    <Entry
                                        Grid.Column="1"
                                        Text="{Binding Trans.Description}"
                                        Placeholder="Ej: Supermercado"
                                        PlaceholderColor="#94A3B8"
                                        TextColor="#0F172A"
                                        BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Monto -->

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="MONTO"
                                FontSize="12"
                                FontAttributes="Bold"
                                CharacterSpacing="0.6"
                                TextColor="#94A3B8"/>

                            <Border
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,2">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label
                                        Grid.Column="0"
                                        Text="payments"
                                        FontFamily="MaterialSymbols"
                                        FontSize="20"
                                        TextColor="#94A3B8"
                                        VerticalOptions="Center"/>

                                    <Entry
                                        Grid.Column="1"
                                        Text="{Binding Trans.Amount}"
                                        Keyboard="Numeric"
                                        Placeholder="$0"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="#0F172A"
                                        BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fecha -->

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="FECHA"
                                FontSize="12"
                                FontAttributes="Bold"
                                CharacterSpacing="0.6"
                                TextColor="#94A3B8"/>

                            <Border
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,2">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label
                                        Grid.Column="0"
                                        Text="calendar_month"
                                        FontFamily="MaterialSymbols"
                                        FontSize="20"
                                        TextColor="#94A3B8"
                                        VerticalOptions="Center"/>

                                    <DatePicker
                                        Grid.Column="1"
                                        Date="{Binding Trans.Date}"
                                        TextColor="#0F172A"
                                        BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Tipo -->

                        <Border
                            BackgroundColor="{Binding Trans.IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#ECFDF5', FalseObject='#FEF2F2'}}"
                            Stroke="{Binding Trans.IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#A7F3D0', FalseObject='#FECACA'}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16,14">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    BackgroundColor="{Binding Trans.IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#D1FAE5', FalseObject='#FEE2E2'}}"
                                    StrokeShape="RoundRectangle 21">

                                    <Label
                                        Text="{Binding Trans.IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='arrow_upward_alt', FalseObject='arrow_downward_alt'}}"
                                        FontFamily="MaterialSymbols"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{Binding Trans.IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#059669', FalseObject='#DC2626'}}"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label
                                        Text="{Binding Trans.IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='Ingreso', FalseObject='Gasto'}}"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{Binding Trans.IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#047857', FalseObject='#B91C1C'}}"/>
                                    <Label
                                        Text="Desliza para cambiar el tipo"
                                        FontSize="12"
                                        TextColor="#64748B"/>
                                </VerticalStackLayout>

                                <Switch
                                    Grid.Column="2"
                                    IsToggled="{Binding Trans.IsIncome}"
                                    OnColor="#10B981"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>

                </Border>

                <!-- Error -->

                <Border
                    IsVisible="{Binding Error, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                    BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,12">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label
                            Grid.Column="0"
                            Text="error"
                            FontFamily="MaterialSymbols"
                            FontSize="20"
                            TextColor="#DC2626"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding Error}"
                            FontSize="13"
                            TextColor="#B91C1C"
                            VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Botón principal -->

                <Border
                    HeightRequest="58"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#3B0764" Offset="0.0" />
                            <GradientStop Color="#7E22CE" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.Shadow>
                        <Shadow Brush="#3B0764" Opacity="0.35" Radius="16" Offset="0,6" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CreateTransactionCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Text="check_circle"
                            FontFamily="MaterialSymbols"
                            FontSize="20"
                            TextColor="White"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Guardar transacción"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Cancelar -->

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">

                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>

                    <Label
                        Text="close"
                        FontFamily="MaterialSymbols"
                        FontSize="16"
                        TextColor="#94A3B8"
                        VerticalOptions="Center"/>

                    <Label
                        Text="Cancelar"
                        FontSize="14"
                        TextColor="#64748B"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
