<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GP.Views.MainPage"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Encabezado morado -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="24,18,24,72">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3B0764" Offset="0.0" />
                    <GradientStop Color="#7E22CE" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <VerticalStackLayout Spacing="22">

                <Label Text="GASTOS"
                       FontSize="13"
                       FontAttributes="Bold"
                       CharacterSpacing="3"
                       TextColor="#D8B4FE"
                       HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="2">
                    <Label Text="Hola,"
                           FontSize="14"
                           TextColor="#C4B5FD" />
                    <Label Text="{Binding UserName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- Tarjeta de balance flotante + botón + -->
        <Grid Grid.Row="1" Margin="20,-58,20,0">

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    Padding="24,22">

                <Border.Shadow>
                    <Shadow Brush="#7E22CE" Opacity="0.22" Radius="24" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Balance"
                               FontSize="14"
                               TextColor="#94A3B8" />
                        <Label Text="{Binding Balance, StringFormat='${0:N2}'}"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Ingresos"
                                   FontSize="13"
                                   TextColor="#94A3B8" />
                            <Label Text="{Binding TotalIncome, StringFormat='${0:N2}'}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Egresos"
                                   FontSize="13"
                                   TextColor="#94A3B8" />
                            <Label Text="{Binding TotalExpenses, StringFormat='${0:N2}'}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border WidthRequest="58"
                    HeightRequest="58"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 29"
                    BackgroundColor="#3B0764"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,16,-26">

                <Border.Shadow>
                    <Shadow Brush="#3B0764" Opacity="0.4" Radius="14" Offset="0,6" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToCreateTransactionCommand}" />
                </Border.GestureRecognizers>

                <Label Text="+"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

        </Grid>

        <!-- Transacciones -->
        <Grid Grid.Row="2"
              RowDefinitions="Auto,*"
              Margin="20,46,20,0">

            <Label Grid.Row="0"
                   Text="Transacciones"
                   FontSize="14"
                   TextColor="#94A3B8"
                   Margin="0,0,0,12" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Transactions}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         Padding="40">
                        <Label Text="Aún no tienes transacciones"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#475569"
                               HorizontalOptions="Center" />
                        <Label Text="Toca el botón + para agregar la primera"
                               FontSize="13"
                               TextColor="#94A3B8"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="0,0,0,12"
                                Padding="16,14"
                                StrokeThickness="0"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 18">

                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Opacity="0.05" Radius="10" Offset="0,3" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Border Grid.Column="0"
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        BackgroundColor="{Binding IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#D1FAE5', FalseObject='#FEE2E2'}}"
                                        StrokeShape="RoundRectangle 23">
                                    <Label Text="{Binding IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='↑', FalseObject='↓'}}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{Binding IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#059669', FalseObject='#DC2626'}}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="14,0"
                                                     VerticalOptions="Center"
                                                     Spacing="3">
                                    <Label Text="{Binding Description}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                           FontSize="13"
                                           TextColor="#94A3B8" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       VerticalOptions="Center"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       Text="{Binding Amount, StringFormat='${0:N0}'}"
                                       TextColor="{Binding IsIncome, Converter={toolkit:BoolToObjectConverter TrueObject='#059669', FalseObject='#DC2626'}}" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>
