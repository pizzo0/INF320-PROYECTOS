<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="GP.Views.SetUserPage"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border StrokeThickness="0" Padding="24,32,24,64">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3B0764" Offset="0.0" />
                        <GradientStop Color="#7E22CE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Tu nombre" FontSize="24" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Ingresa cómo te gustaría que te llamemos" FontSize="14" TextColor="#C4B5FD" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="24,0,24,24" Spacing="22" Margin="0,-46,0,0">

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="22">
                    <Border.Shadow>
                        <Shadow Brush="#7E22CE" Opacity="0.18" Radius="22" Offset="0,8" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="NOMBRE" FontSize="12" FontAttributes="Bold" CharacterSpacing="0.6" TextColor="#94A3B8" />

                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,2">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="person" FontFamily="MaterialSymbols" FontSize="20" TextColor="#94A3B8" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding Username}" Placeholder="JUANITO" PlaceholderColor="#94A3B8" TextColor="#0F172A" BackgroundColor="Transparent" TextTransform="Uppercase" Keyboard="Text" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Border IsVisible="{Binding Error, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="error" FontFamily="MaterialSymbols" FontSize="20" TextColor="#DC2626" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Error}" FontSize="13" TextColor="#B91C1C" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Guardar -->
                        <Border HeightRequest="58" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3B0764" Offset="0.0" />
                                    <GradientStop Color="#7E22CE" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Shadow>
                                <Shadow Brush="#3B0764" Opacity="0.35" Radius="16" Offset="0,6" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SaveUserCommand}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="check_circle" FontFamily="MaterialSymbols" FontSize="20" TextColor="White" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Guardar nombre" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Cancelar -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" IsVisible="{Binding CanGoBack}">

                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>

                    <Label
                        Text="close"
                        FontFamily="MaterialSymbols"
                        FontSize="16"
                        TextColor="#94A3B8"
                        VerticalOptions="Center"/>

                    <Label
                        Text="Cancelar"
                        FontSize="14"
                        TextColor="#64748B"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
